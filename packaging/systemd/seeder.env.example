# Copy to /etc/dissent/seeder.env and edit. Every line is optional; the unit runs with the defaults.
# Reload after a change: sudo systemctl restart dissent-seeder

# Invite link of the server to keep available. Separate several links with commas.
# Get it from a member of the server: Server settings, then Invites.
DISSENT_SEEDER_JOIN=

# Name shown to the server's members for this seeder.
DISSENT_SEEDER_NAME=

# Print a status line every N seconds (default: the seeder's own interval).
#DISSENT_SEEDER_STATUS_EVERY=60

# Also write rolling log files into this directory (stdout/journald is always used).
#DISSENT_SEEDER_LOG_DIR=/var/lib/dissent-seeder/logs

# Use the loopback-only network setup. Leave unset on a server; set only for local testing.
#DISSENT_SEEDER_LOOPBACK=false

# The passphrase is NOT set here. It is read from /etc/dissent/seeder.passphrase (see the README).
