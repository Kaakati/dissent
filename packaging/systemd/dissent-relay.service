[Unit]
Description=Dissent relay: open relay for encrypted Dissent traffic between devices that cannot reach each other
Documentation=https://github.com/Kaakati/dissent/blob/main/packaging/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/dissent-relay
# A dedicated, unprivileged account made for this service. Its state (the ACME certificate cache and the
# relay's own keys) lives in /var/lib/dissent-relay, which systemd creates and keeps across updates.
DynamicUser=yes
StateDirectory=dissent-relay
StateDirectoryMode=0700
UMask=0077
# Configuration: see packaging/systemd/relay.env.example. The file is optional.
EnvironmentFile=-/etc/dissent/relay.env
Environment=DISSENT_RELAY_DATA_DIR=/var/lib/dissent-relay
Environment=DISSENT_RELAY_ACME_CACHE=/var/lib/dissent-relay/acme
# The default ports are 3340 (HTTP probe) and 443 (HTTPS). Binding 443 needs CAP_NET_BIND_SERVICE, and this
# is the only capability the service keeps.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5
# The relay stops on SIGTERM and closes its listeners within its shutdown grace period.
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening. The relay needs the network and its state directory, and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
