# Copy to /etc/dissent/relay.env and edit. The relay needs exactly one TLS mode: the ACME lines below
# (hostname and email, for a public server with a DNS name), or set DISSENT_RELAY_DEV=true for a local test.
# For your own certificate, use DISSENT_RELAY_CERT and DISSENT_RELAY_KEY instead of ACME.
# Reload after a change: sudo systemctl restart dissent-relay

# Public hostname of this relay. With ACME, this name gets a certificate from Let's Encrypt.
DISSENT_RELAY_HOSTNAME=relay.example.org

# Contact address for the certificate authority (Let's Encrypt sends expiry warnings here).
DISSENT_RELAY_ACME_EMAIL=you@example.org

# Use the Let's Encrypt staging server while testing, to avoid rate limits.
#DISSENT_RELAY_ACME_STAGING=true

# Plain HTTP port for the captive-portal probe (default 0.0.0.0:3340).
#DISSENT_RELAY_BIND=0.0.0.0:3340

# HTTPS port for relay traffic (default 0.0.0.0:443).
#DISSENT_RELAY_HTTPS_BIND=0.0.0.0:443

# Also write rolling log files into this directory (stdout/journald is always used).
#DISSENT_RELAY_LOG_DIR=/var/lib/dissent-relay/logs
