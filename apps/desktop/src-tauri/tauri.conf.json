{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dissent",
  "identifier": "chat.dissent.desktop",
  "build": {
    "frontendDist": "../ui",
    "features": [
      "custom-protocol"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dissent",
        "width": 1100,
        "height": 720,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNDM4NjRDRDg2QUM4RDEKUldUUnlHcllUSVpERWM5MGx5TDRCNUl6ek9pZ004NXQwT0FPdHg3RjNUYURmQk5tT2pNSTVxRlYK",
      "endpoints": [
        "https://github.com/Kaakati/dissent/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
